# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
app-temp/

# production
/build/*
!/build/icon.ico
!/build/icon.png
!/build/installer.nsh
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-dev*.log
.next-start*.log
# Pazaryeri kimlik bilgileri — ŞİFRELİ saklansalar bile depoya girmemeli.
# (trendyol zaten kapsanıyordu; shopify ve hepsiburada kapsam DIŞINDAYDI.)
.trendyol-credentials.key
.trendyol-settings.json
/data/*-settings.json
/data/*.key

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
test*.db

# macOS code-signing cert (asla commitleme)
*.p12
*.p12.b64
mac-codesign.p12
app_log.txt

# yerel release helper (cert şifresi içerir)
scripts/*.local.sh

# geçici lokal test build çıktıları
/dist-test*

# yerel açılış/şema yardımcı çıktıları (userData'da; dev'de repo köküne düşebilir)
perf.log
.schema-version

# yerel geliştirme verisi (makineye özel, paylaşılmaz)
.devdata/

# Yazıcı entegrasyonu için kök dizine indirilmiş üçüncü taraf kaynak dökümleri
# (Moonraker / Klipper / Snapmaker). Referans amaçlı, depoya girmemeli.
/_c.txt
/_k.txt
/fm.txt
/fss.txt
/kapi.txt
/meta.txt
/snmk_cloud.txt
/u1m.txt
/vsd.txt

# Test çalıştırmalarından kalan geçici veritabanı
/prisma/t.db
